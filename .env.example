# ==========================================================
# TENDERSCAN ENVIRONMENT VARIABLES
# Copy to .env and configure
# ==========================================================
#
# CONFIGURATION HIERARCHY:
# 1. config.yaml - Main configuration file with all settings
# 2. .env - Environment-specific values and secrets ONLY
#
# Email settings in config.yaml are loaded first, then overridden by these env vars:
# - EMAIL_ENABLED: Enable weekly email sending paths
# - SMTP_SERVER / SMTP_PORT: SMTP connection details
# - SMTP_USER / SMTP_PASSWORD: SMTP login credentials
# - EMAIL_FROM: Optional From address override
# - EMAIL_TO: Recipient list (comma-separated)
#
# Legacy `TENDERSCAN_*` email aliases are still accepted by `weekly_report.py`
# and `utils/email_alerts.py`, but new setups should use the names below.

# ==========================================================
# DATABASE CONFIGURATION
# ==========================================================

# Path to SQLite database (default: data/tenders.db)
DB_PATH=data/tenders.db

# Optional: Flask/static output directory override
OUTPUT_DIR=output

# Optional: Toggle Selenium in the Flask API health surface
ENABLE_SELENIUM=false

# Optional: Show all tenders in dashboard sync even when config is Mexel-only
DASHBOARD_SHOW_ALL=false

# ==========================================================
# EMAIL SECRETS (REQUIRED FOR EMAIL FUNCTIONALITY)
# ==========================================================

# Enable weekly report emails
EMAIL_ENABLED=false

# SMTP connection
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# SMTP credentials (required for sending emails)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Optional: Override sender email (uses config.yaml if not set)
EMAIL_FROM=your-email@gmail.com

# Optional: Override recipients (uses config.yaml if not set)
EMAIL_TO=recipient1@example.com,recipient2@example.com

# Optional: Slack notifications for scraper failures or alerts
SLACK_WEBHOOK_URL=

# Optional: Twilio settings for SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==========================================================
# API SECURITY
# ==========================================================

# Required for protected API endpoints. If omitted, protected endpoints return 503.
# Generate a secure key: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=your-secure-api-key-here

# Comma-separated origins allowed to call /api/* and /cron/* cross-origin.
# Leave empty for the recommended same-origin configuration.
CORS_ORIGINS=

# Legacy cron secret (deprecated - use API_KEY instead)
CRON_SECRET=your-random-secret-key

# OpenAI API Key for summarization endpoint (optional)
OPENAI_API_KEY=sk-your-openai-key-here

# ==========================================================
# FLASK CONFIGURATION
# ==========================================================

PORT=5001
# Loopback is the secure default. Set explicitly only behind a firewall/reverse proxy.
APP_HOST=127.0.0.1
MAX_REQUEST_BYTES=65536
DEBUG=false

# ==========================================================
# NETWORK/TLS
# ==========================================================

# Outbound HTTPS certificate verification is mandatory. For an enterprise CA,
# point Requests at a trusted PEM bundle; never disable verification in code.
# REQUESTS_CA_BUNDLE=/absolute/path/to/enterprise-ca-bundle.pem

# Public deployments must terminate HTTPS at a trusted reverse proxy while the
# application remains bound to loopback/private networking.
# GUNICORN_BIND=127.0.0.1:5001
